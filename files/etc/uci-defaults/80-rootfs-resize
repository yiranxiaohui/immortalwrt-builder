# 首次开机第二阶段（分区扩展重启后）：扩展 ext4 文件系统到分区末尾
if [ ! -e /etc/rootfs-resize ]; then
	[ -e /etc/rootpt-resize ] || exit 1
	ROOT_BLK="$(readlink -f /sys/dev/block/"$(awk '$5=="/" {print $3}' /proc/self/mountinfo | head -n1)")"
	ROOT_DEV="/dev/$(basename "${ROOT_BLK}")"
	LOOP_DEV="$(losetup -f)"
	losetup "${LOOP_DEV}" "${ROOT_DEV}"
	resize2fs -f "${LOOP_DEV}"
	mount_root done
	touch /etc/rootfs-resize
	reboot
fi
exit 1
